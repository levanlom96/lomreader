{
  "name": "lomreader",
  "version": "0.0.1",
  "description": "An open-source EPUB 3.0 reader for JavaScript environments",
  "type": "module",
  "main": "./dist/lomreader.js",
  "module": "./dist/lomreader.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lomreader.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "epub",
    "epub3",
    "reader",
    "accessibility",
    "ebook"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "happy-dom": "^16.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.0"
  }
}
